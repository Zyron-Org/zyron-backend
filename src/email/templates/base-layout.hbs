<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{subject}}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #07090e;
      color: #e2e8f0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, monospace;
      -webkit-font-smoothing: antialiased;
    }
    .wrapper {
      width: 100%;
      background-color: #07090e;
      padding: 40px 0;
    }
    .container {
      max-width: 580px;
      margin: 0 auto;
      background-color: #0d1117;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    }
    .header {
      padding: 24px 32px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: linear-gradient(180deg, rgba(16, 24, 39, 0.8) 0%, rgba(13, 17, 23, 0.8) 100%);
      display: flex;
      align-items: center;
    }
    .logo-badge {
      display: inline-block;
      padding: 4px 10px;
      background-color: rgba(0, 229, 191, 0.1);
      border: 1px solid rgba(0, 229, 191, 0.3);
      border-radius: 4px;
      color: #00e5bf;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.5px;
      font-family: monospace;
    }
    .content {
      padding: 32px;
    }
    .footer {
      padding: 20px 32px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      background-color: #090d13;
      text-align: center;
      font-size: 11px;
      color: #64748b;
      font-family: monospace;
    }
    .btn {
      display: inline-block;
      padding: 12px 24px;
      background-color: #00e5bf;
      color: #07090e !important;
      text-decoration: none;
      font-weight: 600;
      font-size: 13px;
      letter-spacing: 0.5px;
      border-radius: 4px;
      margin-top: 20px;
      margin-bottom: 10px;
      text-transform: uppercase;
      font-family: monospace;
    }
    .code-box {
      background-color: #05070a;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 4px;
      padding: 12px 16px;
      font-family: monospace;
      font-size: 13px;
      color: #00e5bf;
      word-break: break-all;
      margin: 16px 0;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <span class="logo-badge">ZYRON // PROTOCOL SECURITY</span>
      </div>
      <div class="content">
        {{> content}}
      </div>
      <div class="footer">
        <div>ZYRON SECURITY PROTOCOL &bull; AUTONOMOUS SMART CONTRACT AUDIT</div>
        <div style="margin-top: 8px;">&copy; {{currentYear}} Zyron Protocol Labs. All rights reserved.</div>
      </div>
    </div>
  </div>
</body>
</html>
