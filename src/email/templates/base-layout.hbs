<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{subject}}</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #08090C;
      color: #0F172A;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      -webkit-text-size-adjust: 100%;
    }
    table {
      border-collapse: separate;
    }
    a {
      text-decoration: none;
    }
    .email-wrapper {
      width: 100%;
      background-color: #08090C;
      padding: 44px 16px;
    }
    .card-container {
      max-width: 580px;
      margin: 0 auto;
      background-color: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
    }
    .card-header {
      padding: 22px 32px;
      background-color: #FFFFFF;
      border-bottom: 1px solid #F1F5F9;
    }
    .brand-title {
      font-size: 16px;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0F172A;
    }
    .brand-accent {
      color: #0284C7;
    }
    .status-badge {
      display: inline-block;
      padding: 4px 12px;
      background-color: #F0FDF4;
      border: 1px solid #BBF7D0;
      border-radius: 9999px;
      color: #15803D;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.06em;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    }
    .status-dot {
      display: inline-block;
      width: 6px;
      height: 6px;
      background-color: #22C55E;
      border-radius: 50%;
      margin-right: 5px;
      vertical-align: middle;
    }
    .card-content {
      padding: 34px 32px 28px;
      background-color: #FFFFFF;
    }
    h1 {
      margin: 0 0 12px 0;
      font-size: 22px;
      color: #0F172A;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.3;
    }
    p {
      margin: 0 0 16px 0;
      font-size: 14px;
      line-height: 1.65;
      color: #475569;
    }
    .btn-container {
      margin: 28px 0;
      text-align: center;
    }
    .btn-expanding {
      display: inline-table;
      background-color: #0B0D10;
      color: #FFFFFF !important;
      text-decoration: none;
      border-radius: 12px;
      border: 1px solid #1E293B;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
    }
    .sub-card {
      background-color: #F8FAFC;
      border: 1px solid #E2E8F0;
      border-radius: 12px;
      padding: 16px 18px;
      margin: 20px 0;
    }
    .card-footer {
      padding: 22px 32px;
      border-top: 1px solid #F1F5F9;
      background-color: #F8FAFC;
      font-size: 11px;
      color: #94A3B8;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      text-align: center;
      line-height: 1.6;
    }
    .outer-footer {
      max-width: 580px;
      margin: 16px auto 0;
      text-align: center;
      font-size: 10px;
      color: #475569;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      letter-spacing: 0.04em;
    }
  </style>
</head>
<body>
  <div class="email-wrapper">
    <div class="card-container">
      <div class="card-header">
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
          <tr>
            <td align="left" valign="middle">
              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="vertical-align:middle;">
                    <div style="width:30px; height:30px; background-color:#0B0D10; border-radius:8px; text-align:center; line-height:30px; color:#5EC8FF; font-family:ui-monospace, monospace; font-weight:bold; font-size:14px; border:1px solid #262B33;">&gt;_</div>
                  </td>
                  <td style="vertical-align:middle; padding-left:10px;">
                    <span class="brand-title">ZYRON<span class="brand-accent">.</span></span>
                    <span style="font-size:11px; color:#94A3B8; font-weight:600; margin-left:6px; letter-spacing:0.04em;">AI AUDITOR</span>
                  </td>
                </tr>
              </table>
            </td>
            <td align="right" valign="middle">
              <span class="status-badge"><span class="status-dot"></span>ZYRON // PROTOCOL SECURITY</span>
            </td>
          </tr>
        </table>
      </div>
      <div class="card-content">
        {{> content}}
      </div>
      <div class="card-footer">
        <div>ZYRON SECURITY PROTOCOL &bull; AUTONOMOUS SMART CONTRACT AUDIT</div>
        <div style="margin-top: 6px;">&copy; {{currentYear}} Zyron Protocol Labs. All rights reserved.</div>
      </div>
    </div>
    <div class="outer-footer">
      Automated Cryptographic Security Notification &bull; Do Not Reply Direct
    </div>
  </div>
</body>
</html>
