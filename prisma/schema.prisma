generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── USERS & ORGS ───────────────────────────────────────

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?       // null for wallet-only users
  walletAddress   String?       @unique
  name            String
  role            String        @default("CLIENT") // CLIENT, AUDITOR, ADMIN
  avatarUrl       String?
  auditorHandle   String?       // e.g. "0xAuditor_K4"
  specialization  String?
  isAvailable     Boolean       @default(true)
  maxConcurrentAudits Int       @default(3)
  onboardingStatus String       @default("ACTIVE") // APPLICANT, BENCHMARK_PASSED, ACTIVE, SUSPENDED
  emailVerified   Boolean       @default(false)
  emailVerifiedAt DateTime?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  submittedAudits AuditRequest[] @relation("SubmittedBy")
  leadAudits      AuditRequest[] @relation("LeadAuditor")
  peerAudits      AuditRequest[] @relation("PeerAuditor")
  comments        Comment[]
  apiKeys         ApiKey[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
  @@index([walletAddress])
}

model Organization {
  id           String         @id @default(cuid())
  name         String
  tier         String         @default("standard") // standard, enterprise
  billingEmail String?
  taxId        String?
  createdAt    DateTime       @default(now())
  users        User[]
  audits       AuditRequest[]
}

model ApiKey {
  id         String    @id @default(cuid())
  key        String    @unique
  label      String
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

// ─── AUDIT LIFECYCLE ────────────────────────────────────

model AuditRequest {
  id               String     @id // e.g. "ZYR-9481"
  protocolName     String
  contractFileName String
  contractAddress  String?
  gitCommit        String?
  compilerVersion  String
  network          String     @default("Ethereum Mainnet")
  sloc             Int
  stage            String     @default("PENDING") // PENDING, SCANNING, IN_REVIEW, CORRECTIONS_REQUESTED, COMPLETED, FAILED
  stageNumber      Int        @default(1)

  // Source
  sourceCodeUrl    String? // S3 key for uploaded .sol
  githubRepoUrl    String?
  githubBranch     String?
  sourceHash       String?   // SHA-256 of all source files concatenated
  compilerSettings String?   // JSON: { version, optimizer, runs }
  scanTimeoutMs    Int       @default(120000)

  // Invariant selections
  invariants String? // JSON string { reentrancy: true, oracle: true }

  // Timing
  submittedAt         DateTime  @default(now())
  estimatedCompletion DateTime?
  completedAt         DateTime?

  // Attestation (filled on completion)
  bytecodeHash      String?
  reportPdfUrl      String?
  pdfSize           String?
  onChainTxHash     String? // Attestation registry tx
  onChainChainId    Int?
  attestationStatus String  @default("AUTOMATED_ONLY") // AUTOMATED_ONLY, PENDING_REVIEW, MANUALLY_ATTESTED, REVOKED
  merkleRoot        String?
  attestationSig    String?
  engineVersion     String  @default("v3.0.0-ast")
  ruleSetVersion    String  @default("v2026.09")

  // Failure
  failureReason String?

  // Relations
  submittedById  String
  submittedBy    User          @relation("SubmittedBy", fields: [submittedById], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  leadAuditorId  String?
  leadAuditor    User?         @relation("LeadAuditor", fields: [leadAuditorId], references: [id])
  peerAuditorId  String?
  peerAuditor    User?         @relation("PeerAuditor", fields: [peerAuditorId], references: [id])

  findings Finding[]
  rounds   AuditRound[]
  scanJobs ScanJob[]
  scanRuns ScanRun[]
  payment  Payment?
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([submittedById])
  @@index([leadAuditorId])
}

model AuditRound {
  id          String       @id @default(cuid())
  roundNumber Int
  commitSha   String
  status      String       @default("active") // active, completed
  summary     String?
  auditId     String
  audit       AuditRequest @relation(fields: [auditId], references: [id])
  startedAt   DateTime     @default(now())
  completedAt DateTime?
}

// ─── FINDINGS ───────────────────────────────────────────

model Finding {
  id                      String   @id @default(cuid())
  displayId               String   // e.g. "ZYR-9481-001"
  title                   String
  severity                String   // CRITICAL, HIGH, MEDIUM, LOW, INFORMATIONAL
  cvss                    String?
  status                  String   @default("OPEN") // OPEN, FIX_SUBMITTED, RESOLVED, WONT_FIX
  confidence              String   @default("HIGH_CONFIDENCE") // HIGH_CONFIDENCE, NEEDS_MANUAL_REVIEW, INFORMATIONAL
  analysisPass            Int?     // Pass 1..14
  taxonomy                String?  // "SWC-107 · CWE-841"
  location                String?  // "contracts/VaultCore.sol:142"
  impact                  String?
  description             String
  vulnerableCode          String?
  vulnerableLines         String?
  remediatedCode          String?
  remediationNote         String?
  fuzzTestStatus          String?
  isMitigated             Boolean  @default(false)
  mitigationJustification String?
  ruleId                  String?  // e.g. "ZYRON-08-001"
  falsePositive           Boolean  @default(false)
  fpJustification         String?  // Auditor justification for FP marking

  auditId  String
  audit    AuditRequest @relation(fields: [auditId], references: [id])
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditId])
  @@index([severity])
  @@index([status])
}

// ─── COMMENTS (per-finding + per-audit) ─────────────────

model Comment {
  id        String        @id @default(cuid())
  message   String
  commitRef String?       // client fix commit reference
  senderId  String
  sender    User          @relation(fields: [senderId], references: [id])
  auditId   String?
  audit     AuditRequest? @relation(fields: [auditId], references: [id])
  findingId String?
  finding   Finding?      @relation(fields: [findingId], references: [id])
  createdAt DateTime      @default(now())

  @@index([auditId])
  @@index([findingId])
}

// ─── SCANNER ────────────────────────────────────────────

model ScanJob {
  id          String       @id @default(cuid())
  auditId     String
  audit       AuditRequest @relation(fields: [auditId], references: [id])
  tool        String       // "slither", "mythril", "aderyn"
  status      String       @default("queued") // queued, running, completed, failed
  passNumber  Int?         // e.g. 1 of 14
  totalPasses Int?
  logOutput   String?
  results     String?      // parsed findings JSON string
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())

  @@index([auditId])
  @@index([status])
}

model ScanRun {
  id              String       @id @default(cuid())
  auditId         String
  audit           AuditRequest @relation(fields: [auditId], references: [id])
  engineVersion   String
  ruleSetVersion  String
  sourceHash      String?
  totalPasses     Int
  passesCompleted Int          @default(0)
  findingsCount   Int          @default(0)
  diagnostics     String?      // JSON array of non-finding diagnostics
  durationMs      Int?
  status          String       @default("running")
  startedAt       DateTime     @default(now())
  completedAt     DateTime?

  @@index([auditId])
}

// ─── PAYMENTS ───────────────────────────────────────────

model Payment {
  id            String       @id @default(cuid())
  auditId       String       @unique
  audit         AuditRequest @relation(fields: [auditId], references: [id])
  method        String       // CRYPTO_ESCROW, CORPORATE_INVOICE
  amount        Float
  currency      String       @default("USDC")
  chainId       Int?
  escrowTxHash  String?
  releaseTxHash String?
  invoiceUrl    String?
  status        String       @default("PENDING") // PENDING, ESCROWED, PARTIALLY_RELEASED, FULLY_RELEASED, REFUNDED
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
}
