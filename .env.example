# ==============================================================================
# ZYRON BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"
JWT_EXPIRES_IN="24h"
SWAGGER_USER="admin"
SWAGGER_PASS="zyron2026"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Google Gemini AI LLM Configuration
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.5-flash"

# Smart Contract Attestation Configuration (Arbitrum Sepolia)
ATTESTATION_CONTRACT_ADDRESS="0x7682b6ddc20ce79b1cc4c30647f0384e7f2ab918"
ARBITRUM_SEPOLIA_ATTESTATION_ADDRESS="0x7682b6ddc20ce79b1cc4c30647f0384e7f2ab918"
DEFAULT_ATTESTATION_CHAIN_ID=421614
SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# Optional: Relayer operator private key for automated backend gas sponsorship
OPERATOR_PRIVATE_KEY=""

# Static Scanner Engine Settings
SCAN_TIMEOUT_MS=120000
ENGINE_VERSION="v3.0.0-ast"
RULE_SET_VERSION="v2026.09"
FEATURE_SYMBOLIC_EXECUTION=true
FEATURE_TAINT_ANALYSIS=true
FEATURE_INHERITANCE_RESOLUTION=true

# Zyron Autonomous Agent Microservice Integration
ZYRON_AGENT_URL="http://localhost:5001"
AGENT_API_KEY="zyron_agent_internal_secret_key_2026_secure"
CALLBACK_SHARED_SECRET="zyron_callback_hmac_secret_2026"

# Email Configuration (Leave SMTP_HOST empty for automated Ethereal test inbox in dev)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@zyron.security"
APP_URL="http://localhost:3001"

# GitHub OAuth Integration
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET"
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/github/callback"
GITHUB_FRONTEND_REDIRECT="http://localhost:3001/auth/github/callback"
