# ==============================================================================
# ZYRON BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"
JWT_EXPIRES_IN="24h"
SWAGGER_USER="admin"
SWAGGER_PASS="zyron2026"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Meta Model API Configuration (Primary for Hackathon — Standard Mode Only)
AI_PROVIDER="meta"
MODEL_API_KEY="YOUR_META_MODEL_API_KEY"
META_API_BASE_URL="https://api.meta.ai/v1"
META_MODEL="muse-spark-1.3"
META_TIMEOUT_MS=45000
META_MAX_RETRIES=2

# Optional Fallback Cloud AI Providers
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

# Multichain Smart Contract Attestation Configuration
DEFAULT_ATTESTATION_CHAIN_ID=10143

# Chain 1: Monad Testnet (Chain ID 10143 — Deployed)
MONAD_TESTNET_RPC_URL="https://testnet-rpc.monad.xyz"
MONAD_TESTNET_ATTESTATION_ADDRESS="0xBd24D2BFFbc69a17aCe69aaF930fC4e0d979c4D3"
ATTESTATION_CONTRACT_ADDRESS="0xBd24D2BFFbc69a17aCe69aaF930fC4e0d979c4D3"

# Chain 2: Base Sepolia (Chain ID 84532 — Deployed)
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_SEPOLIA_ATTESTATION_ADDRESS="0xc242125A0b342E045Cf0E1c2e02C95D1EAEEC5c4"

# Relayer operator private key for backend gas sponsorship (never commit real keys)
OPERATOR_PRIVATE_KEY=""

# Static Scanner Engine Settings
SCAN_TIMEOUT_MS=120000
ENGINE_VERSION="v3.0.0-ast"
RULE_SET_VERSION="v2026.09"
FEATURE_SYMBOLIC_EXECUTION=true
FEATURE_TAINT_ANALYSIS=true
FEATURE_INHERITANCE_RESOLUTION=true

# Zyron Autonomous Agent Microservice Integration
ZYRON_AGENT_URL="http://localhost:5001"
AGENT_API_KEY="zyron_agent_internal_secret_key_2026_secure"
CALLBACK_SHARED_SECRET="zyron_callback_hmac_secret_2026"

# Email Configuration
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@zyron.security"
APP_URL="http://localhost:3000"

# GitHub OAuth Integration
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/v1/auth/github/callback"
GITHUB_FRONTEND_REDIRECT="http://localhost:3000/auth/github/callback"
